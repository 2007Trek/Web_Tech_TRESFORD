{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/protected-page?file=index.html"
    },
    {
      "source": "/index.html",
      "destination": "/api/protected-page?file=index.html"
    },
    {
      "source": "/blog.html",
      "destination": "/api/protected-page?file=blog.html"
    },
    {
      "source": "/cv.html",
      "destination": "/api/protected-page?file=cv.html"
    },
    {
      "source": "/member.html",
      "destination": "/api/protected-page?file=member.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}